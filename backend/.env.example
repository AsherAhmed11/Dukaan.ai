# Environment variables — copy to .env and fill in values
# Never commit .env to version control

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/dukaan_ai
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/dukaan_ai

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=7d

# Gemini API (Phase 2 — leave blank for now)
GEMINI_API_KEY=
